<?xml version="1.0" ?>

<sdf version="1.9">
    <model name=' $namespace ' >

        <link name='base_link'>
            <gravity>1</gravity>
            <enable_wind>true</enable_wind>
            <pose>0 0 0 0 -0 0</pose>
            <inertial>
            <pose>0 0 0 0 -0 0</pose>
            <mass>0.2</mass>
            <inertia>
                <ixx>0.025</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.025</iyy>
                <iyz>0</iyz>
                <izz>0.033</izz>
            </inertia>
            </inertial>
            <collision name='base_link_inertia_collision'>
            <pose>0 0 0 0 -0 0</pose>
            <geometry>
                <box>
                <size>0.15 0.15 0.08</size>
                </box>
            </geometry>
            </collision>
            <collision name='leg_1_collission'>
            <pose>0.095264 0.1065 -0.096403 0 -0 0</pose>
            <geometry>
                <box>
                <size>0.01 0.01 0.025</size>
                </box>
            </geometry>
            </collision>
            <collision name='leg_2_collission'>
            <pose>-0.106236 0.10704 -0.096403 0 0 0</pose>
            <geometry>
                <box>
                <size>0.01 0.01 0.025</size>
                </box>
            </geometry>
            </collision>
            <collision name='leg_3_collission'>
            <pose>-0.106236 -0.10704 -0.096403 0 0 0</pose>
            <geometry>
                <box>
                <size>0.01 0.01 0.025</size>
                </box>
            </geometry>
            </collision>
            <collision name='leg_4_collission'>
            <pose>0.095264 -0.106464 -0.096403 0 0 0</pose>
            <geometry>
                <box>
                <size>0.01 0.01 0.025</size>
                </box>
            </geometry>
            </collision>
            <visual name='base_link_inertia_visual'>
            <pose>0 0 0 0 -0 0</pose>
            <geometry>
                <mesh>
                <scale>1 1 1</scale>
                <uri>package://robomaster_gz/models/rmtt/meshes/base.dae</uri>
                </mesh>
            </geometry>
            <material>
                <diffuse>0.65 0.1 0.1 0.95</diffuse>
                <ambient>0.65 0.1 0.1 0.95</ambient>
            </material>
            </visual>


            <visual name="x_axis">
                <pose>0.1 0 0 1.57 0 1.57</pose>
                <geometry>
                    <cylinder>
                    <radius>0.01</radius>
                    <length>0.2</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                    <specular>1 0 0 1</specular>
                </material>
            </visual>
            <visual name="x_axis_cone">
                <pose>0.25 0 0 1.57 0 1.57</pose>
                <geometry>
                    <cone>
                    <radius>0.015</radius>
                    <length>0.1</length>
                    </cone>
                </geometry>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                    <specular>1 0 0 1</specular>
                </material>
            </visual>
            <visual name="y_axis">
                <pose>0 0.1 0 0 1.57 1.57</pose>
                <geometry>
                    <cylinder>
                    <radius>0.01</radius>
                    <length>0.2</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0 1 0 1</ambient>
                    <diffuse>0 1 0 1</diffuse>
                    <specular>0 1 0 1</specular>
                </material>
            </visual>
            <visual name="y_axis_cone">
                <pose>0 0.25 0 0 1.57 1.57</pose>
                <geometry>
                    <cone>
                    <radius>0.015</radius>
                    <length>0.1</length>
                    </cone>
                </geometry>
                <material>
                    <ambient>0 1 0 1</ambient>
                    <diffuse>0 1 0 1</diffuse>
                    <specular>0 1 0 1</specular>
                </material>
            </visual>
            <visual name="z_axis">
                <pose>0 0 0.1 0 0 0</pose>
                <geometry>
                    <cylinder>
                    <radius>0.01</radius>
                    <length>0.2</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>
                    <diffuse>0 0 1 1</diffuse>
                    <specular>0 0 1 1</specular>
                </material>
            </visual>
            <visual name="z_axis_cone">
                <pose>0 0 0.25 0 0 0</pose>
                <geometry>
                    <cone>
                    <radius>0.015</radius>
                    <length>0.1</length>
                    </cone>
                </geometry>
                <material>
                    <ambient>0 0 1 1</ambient>
                    <diffuse>0 0 1 1</diffuse>
                    <specular>0 0 1 1</specular>
                </material>
            </visual>

            <sensor name="imu" type="imu">
                <always_on>1</always_on>
                <update_rate>20</update_rate>
                <visualize>true</visualize>
                <topic>$namespace/imu</topic>
                <enable_metrics>false</enable_metrics>
            </sensor>
            <sensor name="air_pressure" type="air_pressure">
                <always_on>1</always_on>
                <update_rate>20</update_rate>
                <visualize>true</visualize>
                <topic>$namespace/baro</topic>
                <enable_metrics>false</enable_metrics>
                <air_pressure>
                    <reference_altitude>123</reference_altitude>
                    <pressure>
                    <noise type="gaussian">
                        <mean>0.2</mean>
                        <stddev>0.1</stddev>
                    </noise>
                    </pressure>
                </air_pressure>
            </sensor>
            <sensor name="altimeter" type="altimeter">
                <always_on>1</always_on>
                <update_rate>20</update_rate>
                <visualize>true</visualize>
                <topic>$namespace/altimeter</topic>
                <enable_metrics>false</enable_metrics>
            </sensor>
        </link>

        <link name="camera">
            <pose>0.085 0 -0.015 0 -0 0</pose>
            <!-- <visual name="camera_visual">
                <pose>0 0 0 0 -0 0</pose>
                <geometry>
                    <cone>
                        <radius>0.01</radius>
                        <length>0.02</length>
                    </cone>
                </geometry>
                <material>
                    <diffuse>0.5 0.5 0.5 1</diffuse>
                    <ambient>0.5 0.5 0.5 1</ambient>
                </material>
                <cast_shadows>0</cast_shadows>
            </visual> -->
            <inertial>
            <mass>0.0001</mass>
            <inertia>
                <ixx>0.00000000025</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.00000000025</iyy>
                <iyz>0</iyz>
                <izz>0.00000000025</izz>
            </inertia>
            </inertial>
            <sensor name="camera" type="camera">
                <always_on>1</always_on>
                <update_rate>5</update_rate>
                <visualize>true</visualize>
                <topic>$namespace/camera/image_raw</topic>
                <enable_metrics>false</enable_metrics>
                <camera>
                    <horizontal_fov>1.14</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>R8G8B8</format>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.01</stddev>
                        </noise>
                    </image>
                    <clip>
                        <near>0.01</near>
                        <far>100.0</far>
                    </clip>
                </camera>
            </sensor>
        </link>
        <joint name="camera_joint" type="fixed">
            <parent>base_link</parent>
            <child>camera</child>
            <pose>0 0 0 0 -0 0</pose>
        </joint>

        <link name="camera_bottom">
            <pose>0.055 0 -0.0465 -0 1.57 0</pose>
            <!-- <visual name="camera_visual">
                <pose>0 0 0 0 -0 0</pose>
                <geometry>
                    <cone>
                        <radius>0.01</radius>
                        <length>0.02</length>
                    </cone>
                </geometry>
                <material>
                    <diffuse>0.5 0.5 0.5 1</diffuse>
                    <ambient>0.5 0.5 0.5 1</ambient>
                </material>
                <cast_shadows>0</cast_shadows>
            </visual> -->
            <inertial>
            <mass>0.0001</mass>
            <inertia>
                <ixx>0.00000000025</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>0.00000000025</iyy>
                <iyz>0</iyz>
                <izz>0.00000000025</izz>
            </inertia>
            </inertial>
            <sensor name="camera" type="camera">
                <always_on>1</always_on>
                <update_rate>5</update_rate>
                <visualize>true</visualize>
                <topic>$namespace/camera_bottom/image_raw</topic>
                <enable_metrics>false</enable_metrics>
                <camera>
                    <horizontal_fov>1.14</horizontal_fov>
                    <image>
                        <width>640</width>
                        <height>480</height>
                        <format>L8</format>
                        <noise type="gaussian">
                            <mean>0.0</mean>
                            <stddev>0.01</stddev>
                        </noise>
                    </image>
                    <clip>
                        <near>0.01</near>
                        <far>100.0</far>
                    </clip>
                </camera>
            </sensor>
        </link>
        <joint name="camera_bottom_joint" type="fixed">
            <parent>base_link</parent>
            <child>camera_bottom</child>
            <pose>0 0 0 0 -0 0</pose>
        </joint>
        

        <link name='rotor_0'>
            <pose>0.095264 0.1065 0.021403 0 0 0</pose>
            <inertial>
            <pose>0 0 0 0 -0 0</pose>
            <mass>0.005</mass>
            <inertia>
                <ixx>9.75e-07</ixx>
                <ixy>0</ixy>
                <ixz>0</ixz>
                <iyy>4.17041e-05</iyy>
                <iyz>0</iyz>
                <izz>4.26041e-05</izz>
            </inertia>
            </inertial>
            <collision name='rotor_0_collision'>
            <pose>0 0 0 0 -0 0</pose>
            <geometry>
                <cylinder>
                <length>0.005</length>
                <radius>0.1</radius>
                </cylinder>
            </geometry>
            <surface>
                <contact>
                <ode/>
                </contact>
                <friction>
                <ode/>
                </friction>
            </surface>
            </collision>
            <visual name='rotor_0_visual'>
            <pose>0 0 0 0 -0 0</pose>
            <geometry>
                <mesh>
                <scale>1 1 1</scale>
                <uri>package://robomaster_gz/models/rmtt/meshes/prop_1.stl</uri>
                </mesh>
            </geometry>
            <material>
                <diffuse>0.5 0. 0. 0.800000012</diffuse>
                <ambient>0.5 0. 0. 0.800000012</ambient>
            </material>
            <cast_shadows>0</cast_shadows>
            </visual>
            <gravity>1</gravity>
            <velocity_decay/>
        </link>
        <joint name='rotor_0_joint' type='revolute'>
            <child>rotor_0</child>
            <parent>base_link</parent>
            <axis>
            <xyz expressed_in='__model__'>0 0 1</xyz>
            <limit>
                <lower>-1e+16</lower>
                <upper>1e+16</upper>
            </limit>
            <dynamics>
                <spring_reference>0</spring_reference>
                <spring_stiffness>0</spring_stiffness>
            </dynamics>
            </axis>
        </joint>
        
